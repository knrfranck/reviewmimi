rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signup, login, role loading — users may only access their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Movie Lounge — public browsing; open writes for development
    // (Server actions use Admin SDK and bypass these rules.)
    match /movies/{movieId} {
      allow read: if true;
      allow write: if true;
    }

    match /movieReviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    match /polls/{pollId} {
      allow read: if true;
      allow write: if true;
    }

    match /pollVotes/{voteId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
